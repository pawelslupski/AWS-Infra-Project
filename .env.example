# Copy to .env and adjust. .env is in .gitignore.

# --- AWS SDK v2 -> LocalStack (used by the services in containers) ---
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# --- Kafka ---
# From a container: kafka:19092
# From the host:    localhost:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:19092

# --- Service ports (host) ---
ORDERING_PORT=8081
PAYMENT_PORT=8082
WAREHOUSE_PORT=8083
